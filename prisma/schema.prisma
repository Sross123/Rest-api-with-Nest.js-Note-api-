generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String @id @default(uuid())
  name     String
  email    String @unique
  password String

  note Note[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Note {
  id      String @id @default(uuid())
  title   String
  content String

  UserId String
  user   User   @relation(fields: [UserId], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt()

  @@index([UserId])
}
